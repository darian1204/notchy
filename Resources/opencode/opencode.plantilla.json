{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "default_agent": "notchy",
  "enabled_providers": ["opencode"],
  "model": "opencode/glm-5.3-flash-free",
  "agent": {
    "notchy": {
      "description": "Agente de voz de Notchy",
      "mode": "primary",
      "prompt": "{file:./prompt-agente.md}"
    }
  },
  "mcp": {
    "notchy": {
      "type": "remote",
      "enabled": true,
      "url": "http://127.0.0.1:{{PUERTO}}/mcp",
      "headers": { "Authorization": "Bearer {{TOKEN}}" }
    }
  },
  "tools": {
    "bash": false,
    "edit": false,
    "write": false,
    "read": false,
    "glob": false,
    "grep": false,
    "list": false,
    "patch": false,
    "webfetch": false,
    "todowrite": false,
    "todoread": false,
    "task": false,
    "notchy_*": true
  },
  "permission": {
    "*": "deny",
    "notchy_*": "allow"
  }
}
